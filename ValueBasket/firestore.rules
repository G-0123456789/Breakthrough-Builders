rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Collections with isActive/isPublished filters
    match /stores/{storeId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /catalogues/{catalogueId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /advertisements/{adId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Private User Profiles and Subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /loyaltyCards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{slotId} {
        allow read, write: if isOwner(userId) && slotId.matches('^slot(0[1-9]|1[0-5])$');
      }

      match /basketItems/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.offerId is string
          && request.resource.data.offerId.size() > 0
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 99
          && request.resource.data.expiresAt is timestamp;
      }

      match /claimedRewards/{rewardId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Admin Roles - Client Write Prohibited
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Import Audit Logs - Admin Read Only
    match /importRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

  }
}
